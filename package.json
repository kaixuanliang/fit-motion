{
  "name": "fit-motion",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "Turn FIT activity files into cinematic 9:16 motion reels.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "tsc --noEmit && node tools/build-web.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "android:apk": "npm run build && node android/build-apk.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^1.3.1",
    "pbf": "^3.2.1"
  }
}
